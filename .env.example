# Base de datos Postgres (Neon). En Vercel la completa sola la integración de Neon.
DATABASE_URL=postgres://usuario:clave@host/neondb?sslmode=require

# Contraseña del panel /admin (elegí una larga)
ADMIN_PASSWORD=

# Opcional: texto largo al azar para firmar la sesión del admin
ADMIN_SESSION_SECRET=

# Fotos: token de Vercel Blob. En Vercel lo completa solo al conectar Blob al proyecto.
# Sin token (desarrollo local) las fotos se guardan en public/uploads.
BLOB_READ_WRITE_TOKEN=

# Dirección pública del sitio. En Vercel se toma sola; definila cuando pases al dominio propio.
NEXT_PUBLIC_SITE_URL=

# Medición (opcionales: si están vacías no se carga nada)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
